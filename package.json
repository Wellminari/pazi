{
  "name": "pazi-desktop",
  "productName": "Pazi",
  "version": "0.2.5",
  "description": "Pazi para Windows — painel e Pazi Atende com som, notificações e impressão direta",
  "author": "Pazinari",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/config.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.pazi.desktop",
    "productName": "Pazi",
    "copyright": "Copyright © Pazinari",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/icon.ico", "to": "icon.ico" },
      { "from": "build/atende.ico", "to": "atende.ico" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "Pazi-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pazi",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Wellminari",
        "repo": "pazi",
        "releaseType": "release"
      }
    ]
  }
}
